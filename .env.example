# Claude API key for the tutor chat and writing feedback.
ANTHROPIC_API_KEY=

# Optional. When set, the whole site asks for this password first (handy while testing).
SITE_PASSWORD=

# Optional: parent accounts and admin. Accounts switch on when BOTH of these are set;
# until then the site works without signing in, saving progress in the browser.
# A Postgres connection string, e.g. from Neon (Vercel Marketplace) or Azure. Then run `npm run db:migrate`.
DATABASE_URL=
# Signs sign-in cookies. At least 32 random characters: `openssl rand -base64 32`. Changing it signs everyone out.
AUTH_SECRET=
# Comma-separated emails that become admins when they sign up or sign in.
ADMIN_EMAILS=

# Optional: Suni's Australian voice (Azure en-AU-NatashaNeural), the same on every device.
# From an Azure "Speech service" resource: Keys and Endpoint. Without these, Suni uses the device's own voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
